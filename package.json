{
  "name": "lomi-doc-review",
  "private": true,
  "packageManager": "pnpm@9.14.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @lomi/database exec prisma generate",
    "db:migrate": "pnpm --filter @lomi/database exec prisma migrate deploy",
    "db:push": "pnpm --filter @lomi/database exec prisma db push"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  }
}